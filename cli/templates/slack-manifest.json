{
  "display_information": {
    "name": "Agent",
    "description": "Workspace agent",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "agent_view": {
      "agent_description": "A workspace agent that searches company knowledge, works with files, manages memory, and completes operational tasks.",
      "suggested_prompts": [
        {
          "title": "Search company knowledge",
          "message": "Search our company knowledge for the latest information relevant to my work."
        },
        {
          "title": "Summarize recent work",
          "message": "Summarize the recent work and decisions that matter to me."
        },
        {
          "title": "Help with a task",
          "message": "Help me plan and complete a task using the tools available to you."
        }
      ]
    },
    "bot_user": {
      "display_name": "agent",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "chat:write",
        "chat:write.customize",
        "im:history",
        "im:read",
        "im:write",
        "users:read",
        "users:read.email",
        "channels:read",
        "channels:history",
        "channels:manage",
        "groups:read",
        "groups:history",
        "groups:write",
        "mpim:read",
        "mpim:write",
        "mpim:history",
        "files:read",
        "files:write",
        "reactions:write",
        "reactions:read",
        "emoji:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups",
        "message.mpim",
        "member_joined_channel",
        "member_left_channel",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
